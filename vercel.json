{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso/index.html"
    },
    {
      "source": "/excluir-conta",
      "destination": "/excluir-conta/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
